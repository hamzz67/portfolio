---
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import { documents, documentCategories } from '@/data/documents';
import { profile } from '@/data/profile';
import { formatMonthCap } from '@/lib/format';
import { getProjects } from '@/lib/projects';

/* Documents déclarés dans src/data/documents.ts + documents joints aux fiches */
const projects = await getProjects();
const fromProjects = projects.flatMap((p) =>
  p.data.documents.map((doc) => ({
    title: doc.label,
    href: doc.href,
    category: 'technique' as const,
    description: `Joint à la fiche « ${p.data.title} »`,
    format: doc.type,
  })),
);
const all = [
  ...(profile.links.cv ? [{ title: 'Curriculum vitae', href: profile.links.cv, category: 'cv' as const, description: 'Version publique, sans coordonnées personnelles.', format: 'PDF' }] : []),
  ...documents,
  ...fromProjects,
];
const groups = Object.entries(documentCategories)
  .map(([key, label]) => ({ key, label, items: all.filter((d) => d.category === key) }))
  .filter((g) => g.items.length > 0);
const isPdf = (href: string) => href.toLowerCase().endsWith('.pdf');
---

<Base
  title="Documents — rapports, dossiers et schémas"
  description="Documents publics : rapports de stage, dossiers techniques, schémas et CV, en version vérifiée sans donnée sensible."
>
  <section class="section">
    <div class="container cols">
      <div>
        <div class="head" data-index="Documents">
          <h1>Documents</h1>
          <p>Rapports, dossiers techniques, schémas et CV. Chaque document publié ici est une version « public-safe » : anonymisée, sans identifiant ni donnée interne.</p>
        </div>

        {groups.length > 0 ? (
          <div class="docs">
            {groups.map((g) => (
              <section aria-labelledby={`docs-${g.key}`}>
                <h2 id={`docs-${g.key}`} class="docs__title">{g.label}</h2>
                <ul class="rows" role="list">
                  {g.items.map((d) => (
                    <li class="doc row" data-reveal>
                      <div>
                        <p class="row-title">{d.title}</p>
                        <p class="meta">
                          {d.format ?? 'PDF'}
                          {'date' in d && d.date && <> · {formatMonthCap(d.date)}</>}
                          {'size' in d && d.size && <> · {d.size}</>}
                          {d.description && <> · {d.description}</>}
                        </p>
                      </div>
                      <p class="doc__actions">
                        {isPdf(d.href) && <a class="link" href={d.href} target="_blank" rel="noopener">Ouvrir</a>}
                        <a class="link" href={d.href} download>Télécharger</a>
                      </p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <EmptyState
            title="Aucun document publié pour le moment"
            text="Rapports de stage, dossiers techniques, schémas et CV seront ajoutés ici après vérification (CONTENT-SAFETY.md). Les fichiers se placent dans public/documents/."
            file="src/data/documents.ts"
          />
        )}
      </div>

      <aside class="policy meta" data-reveal>
        <p class="kicker">Politique de publication</p>
        <p>Aucun document ne contient d’adresse personnelle, de numéro de téléphone, d’identifiants, de mots de passe, de clés ou de données internes d’entreprise. Les captures d’écran sont anonymisées et les adresses IP remplacées par des plages d’exemple.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .docs { display: flex; flex-direction: column; gap: var(--s-6); }
  .docs__title { font-size: var(--text-md); margin-bottom: var(--s-3); }
  .doc { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-4); align-items: start; }
  .doc__actions { display: flex; gap: var(--s-4); font-size: var(--text-sm); white-space: nowrap; padding-top: 0.15rem; }
  @media (max-width: 560px) { .doc { grid-template-columns: 1fr; } }
  .policy { max-width: 36ch; }
  @media (min-width: 900px) { .policy { padding-top: 0.35rem; } }
</style>
