---
import Base from '@/layouts/Base.astro';
---

<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="section">
    <div class="container measure">
      <p class="kicker rise">Erreur 404</p>
      <h1 class="rise" style="--d:80ms">Page introuvable</h1>
      <p class="nf__text rise" style="--d:160ms">L’adresse est peut-être erronée, ou la fiche a été renommée. Tous les travaux sont référencés dans la bibliothèque.</p>
      <p class="nf__links rise" style="--d:240ms"><a class="link" href="/">Accueil</a> · <a class="link" href="/travaux">Travaux</a> · <a class="link" href="/parcours">Parcours</a></p>
    </div>
  </section>
</Base>

<style>
  .nf__text { margin-top: var(--s-3); color: var(--ink-2); }
  .nf__links { margin-top: var(--s-5); }
</style>
