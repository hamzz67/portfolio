---
import Base from '@/layouts/Base.astro';
import Timeline from '@/components/Timeline.astro';
import EmptyState from '@/components/EmptyState.astro';
import { profile } from '@/data/profile';
import { certifications } from '@/data/certifications';
import { formatMonthCap } from '@/lib/format';
import { getProjects } from '@/lib/projects';

const stage = (await getProjects()).find((p) => p.data.kind === 'stage');
const typeLabel = { certification: 'Certification', formation: 'Formation', badge: 'Badge' } as const;
const statusLabel = { obtenue: 'obtenue', 'en-cours': 'en cours', prevue: 'prévue' } as const;
---

<Base
  title="Parcours — formation, stage et certifications"
  description={`Parcours de ${profile.name} : BTS SIO SISR au ${profile.school} (${profile.city}), 2025-2027, stage chez Enerdys, certifications.`}
>
  <section class="section">
    <div class="container cols">
      <div>
        <div class="head">
          <h1>Parcours</h1>
          <p>{profile.studies.fullLabel}. {profile.goal}</p>
        </div>
        <Timeline />
      </div>

      <aside class="side">
        <dl class="facts">
          <div>
            <dt>Formation</dt>
            <dd>{profile.studies.label}<br /><span class="meta">{profile.school}, {profile.city}<br />Septembre 2025 → juillet 2027</span></dd>
          </div>
          {stage && (
            <div>
              <dt>Stage de première année</dt>
              <dd>
                <a class="link" href={`/travaux/${stage.id}`}>{stage.data.organization ?? 'Enerdys — Entzheim'}</a>
                <br /><span class="meta">{formatMonthCap(stage.data.date)} · {stage.data.summary}</span>
              </dd>
            </div>
          )}
          <div>
            <dt>Après le BTS</dt>
            <dd class="meta">{profile.goal} Poursuite d’études envisagée vers l’ingénierie (école d’ingénieurs ou formation équivalente).</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="certifications" aria-labelledby="certif-title">
    <div class="container">
      <div class="head">
        <h2 id="certif-title">Certifications et formations</h2>
        <p>Certifications officielles, badges (Cisco Networking Academy, etc.) et formations complémentaires, ajoutés au fur et à mesure.</p>
      </div>

      {certifications.length > 0 ? (
        <ul class="rows" role="list">
          {certifications.map((c) => (
            <li class="cert row">
              <time class="mono" datetime={c.date}>{formatMonthCap(c.date)}</time>
              <div class="cert__body">
                <p class="row-title">
                  {c.url ? <a class="link" href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}
                  {c.status && c.status !== 'obtenue' && <span class="cert__status"> · {statusLabel[c.status]}</span>}
                </p>
                <p class="meta">{typeLabel[c.type ?? 'certification']} · {c.issuer}{c.pdf && <> · <a class="link" href={c.pdf} target="_blank" rel="noopener">certificat (PDF)</a></>}</p>
                {c.description && <p class="cert__desc">{c.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="Aucune certification publiée pour le moment"
          text="Les certifications et badges obtenus pendant la formation apparaîtront ici (nom, organisme, date, lien de vérification, certificat PDF)."
          file="src/data/certifications.ts"
        />
      )}
    </div>
  </section>
</Base>

<style>
  .facts { margin: 0; border-top: 1px solid var(--line); }
  .facts div { padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: var(--text-xs); font-weight: 500; color: var(--ink-3); margin-bottom: 0.15rem; }
  .facts dd { margin: 0; font-size: var(--text-sm); line-height: 1.5; }
  @media (min-width: 900px) { .side { padding-top: 0.35rem; } }

  .cert { display: grid; grid-template-columns: 1fr; gap: 0.2rem var(--s-5); }
  @media (min-width: 640px) { .cert { grid-template-columns: 8.5rem minmax(0, 1fr); } }
  .cert time { color: var(--ink-3); padding-top: 0.15rem; }
  .cert__status { color: var(--warn); font-weight: 400; font-size: var(--text-sm); }
  .cert__desc { margin-top: 0.3rem; color: var(--ink-2); font-size: var(--text-sm); max-width: var(--measure); }
</style>
