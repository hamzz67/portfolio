---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import Timeline from '@/components/Timeline.astro';
import EmptyState from '@/components/EmptyState.astro';
import { profile } from '@/data/profile';
import { certifications } from '@/data/certifications';
import { formatMonthCap } from '@/lib/format';
import { getProjects } from '@/lib/projects';

const stage = (await getProjects()).find((p) => p.data.kind === 'stage');
const typeLabel = { certification: 'Certification', formation: 'Formation', badge: 'Badge' } as const;
const statusLabel = { obtenue: 'Obtenue', 'en-cours': 'En cours', prevue: 'Prévue' } as const;
---

<Base
  title="Parcours — formation, stage et certifications"
  description={`Parcours de ${profile.name} : BTS SIO SISR au ${profile.school} (${profile.city}), 2025-2027, stage chez Enerdys, certifications.`}
>
  <section class="section section--tight">
    <div class="container">
      <SectionHead level="h1" index="02" label="Parcours" titleHtml="Une formation en <span class='em'>deux ans</span>, un cap clair">
        {profile.studies.fullLabel}. {profile.goal}
      </SectionHead>

      <div class="parcours">
        <div class="parcours__main">
          <Timeline />
        </div>
        <aside class="parcours__side reveal-group">
          <div class="card parcours__card reveal">
            <span class="label"><Icon name="graduation-cap" size={14} /> Formation</span>
            <p class="parcours__card-title">{profile.studies.label}</p>
            <p class="parcours__card-text">{profile.school}, {profile.city}<br />Septembre 2025 → juillet 2027</p>
          </div>
          {stage && (
            <a href={`/travaux/${stage.id}`} class="card card--link parcours__card reveal" style="--i:1">
              <span class="label"><Icon name="briefcase" size={14} /> Stage de première année</span>
              <p class="parcours__card-title">{stage.data.organization ?? 'Enerdys — Entzheim'}</p>
              <p class="parcours__card-text">{formatMonthCap(stage.data.date)} · {stage.data.summary}</p>
              <span class="parcours__card-link label label--accent">Voir la fiche <Icon name="arrow-up-right" size={12} /></span>
            </a>
          )}
          <div class="card parcours__card reveal" style="--i:2">
            <span class="label"><Icon name="route" size={14} /> Après le BTS</span>
            <p class="parcours__card-text">{profile.goal} Poursuite d’études envisagée vers l’ingénierie (école d’ingénieurs ou formation équivalente).</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="certifications" aria-labelledby="certif-title">
    <div class="container">
      <SectionHead index="02.1" label="Certifications & formations" titleHtml="Certifications, <span class='em'>badges</span> et formations" id="certif-title">
        Certifications officielles, badges (Cisco Networking Academy, etc.) et formations complémentaires — ajoutés au fur et à mesure.
      </SectionHead>

      {certifications.length > 0 ? (
        <ul class="certs reveal-group" role="list">
          {certifications.map((c, i) => (
            <li class="card cert reveal" style={`--i:${i}`}>
              <div class="cert__head">
                <span class="cert__icon"><Icon name="award" size={20} strokeWidth={1.5} /></span>
                <span class="chips">
                  <span class="chip">{typeLabel[c.type ?? 'certification']}</span>
                  {c.status && c.status !== 'obtenue' && <span class="chip chip--signal">{statusLabel[c.status]}</span>}
                </span>
              </div>
              <h3 class="cert__title">{c.name}</h3>
              <p class="cert__issuer label">{c.issuer} · {formatMonthCap(c.date)}</p>
              {c.description && <p class="cert__desc">{c.description}</p>}
              {(c.url || c.pdf) && (
                <div class="cert__links">
                  {c.url && <a href={c.url} class="btn btn--secondary btn--sm" target="_blank" rel="noopener">Vérifier <Icon name="arrow-up-right" size={12} /></a>}
                  {c.pdf && <a href={c.pdf} class="btn btn--ghost btn--sm" target="_blank" rel="noopener"><Icon name="file-text" size={12} /> Certificat</a>}
                </div>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="Aucune certification publiée pour le moment"
          text="Les certifications et badges obtenus pendant la formation apparaîtront ici (nom, organisme, date, lien de vérification, certificat PDF)."
          file="src/data/certifications.ts"
        />
      )}
    </div>
  </section>
</Base>

<style>
  .parcours { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 1024px) { .parcours { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-8); } }
  .parcours__side { display: flex; flex-direction: column; gap: var(--space-4); }
  @media (min-width: 1024px) { .parcours__side { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .parcours__card { padding: 1.25rem; gap: 0.5rem; }
  .parcours__card .label { display: inline-flex; align-items: center; gap: 0.4rem; }
  .parcours__card-title { font-family: var(--font-display); font-size: var(--text-lg); }
  .parcours__card-text { font-size: var(--text-sm); color: var(--ink-2); }
  .parcours__card-link { margin-top: 0.25rem; }

  .certs { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .cert { padding: 1.25rem; gap: 0.6rem; }
  .cert__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; }
  .cert__icon { color: var(--accent); }
  .cert__title { font-size: var(--text-lg); }
  .cert__desc { font-size: var(--text-sm); color: var(--ink-2); }
  .cert__links { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
</style>
