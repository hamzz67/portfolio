---
import Base from '@/layouts/Base.astro';
import { skillDomains } from '@/data/skills';
import { BTS_BLOCS, blocKeys } from '@/data/taxonomy';
import { getProjects, getProjectsForSkill } from '@/lib/projects';
import { slugify } from '@/lib/format';

const projects = await getProjects();

const domains = await Promise.all(
  skillDomains.map(async (domain) => ({
    ...domain,
    skills: await Promise.all(
      domain.skills.map(async (skill) => ({ ...skill, projects: skill.placeholder ? [] : await getProjectsForSkill(skill.name) })),
    ),
  })),
);

const blocs = blocKeys.map((b) => ({ id: b, label: BTS_BLOCS[b].label, projects: projects.filter((p) => p.data.bts.includes(b)) }));
const totalSkills = domains.reduce((n, d) => n + d.skills.filter((s) => !s.placeholder).length, 0);
---

<Base
  title="Compétences — réseaux, systèmes, cybersécurité, développement"
  description="Compétences confirmées en BTS SIO SISR, organisées par domaine et reliées aux travaux qui les mobilisent : Cisco, VLAN, routage, Linux, Windows, virtualisation, sécurité."
>
  <section class="section">
    <div class="container">
      <div class="head" data-index="01 — Par domaine">
        <h1>Compétences</h1>
        <p>{totalSkills} compétences confirmées, par domaine. Pas de pourcentages : chaque ligne renvoie vers les fiches qui la mettent en œuvre.</p>
      </div>

      <nav class="jump meta" aria-label="Domaines">
        {domains.map((d) => <a href={`#${d.id}`}>{d.label}</a>)}
        <a href="#referentiel">Référentiel BTS</a>
      </nav>

      <div class="domains">
        {domains.map((domain) => (
          <section class="domain cols" id={domain.id} aria-labelledby={`${domain.id}-title`}>
            <div class="domain__intro" data-reveal>
              <h2 id={`${domain.id}-title`}>{domain.label}</h2>
              <p class="meta">{domain.description}</p>
            </div>
            <ul class="rows" role="list">
              {domain.skills.map((skill) => (
                <li class="skill row" data-reveal>
                  <div>
                    {skill.placeholder ? (
                      <span class="meta"><span class="todo">TODO</span> {skill.name.replace(/^TODO\s*[—-]?\s*/i, '')}</span>
                    ) : (
                      <span class="skill__name">{skill.name}</span>
                    )}
                    {skill.note && <span class="skill__note meta">{skill.note}</span>}
                  </div>
                  <div class="skill__rel meta">
                    {skill.projects.length > 0 ? (
                      <>
                        {skill.projects.slice(0, 3).map((p, i) => (
                          <>
                            {i > 0 && ', '}
                            <a class="link" href={`/travaux/${p.id}`}>{p.data.title}</a>
                          </>
                        ))}
                        {skill.projects.length > 3 && <>, <a class="link" href={`/travaux?tech=${slugify(skill.name)}`}>+{skill.projects.length - 3}</a></>}
                      </>
                    ) : (
                      !skill.placeholder && <span>fiche à venir</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="referentiel" aria-labelledby="ref-title">
    <div class="container">
      <div class="head" data-index="02 — Référentiel BTS">
        <h2 id="ref-title">Blocs de compétences du BTS SIO</h2>
        <p>Chaque fiche peut être rattachée à un ou plusieurs blocs du référentiel, pour faciliter la lecture par le jury.</p>
      </div>
      <dl class="blocs">
        {blocs.map((b) => (
          <div class="bloc" data-reveal>
            <dt><span class="mono bloc__id">{b.id}</span> {b.label}</dt>
            <dd class="meta">
              {b.projects.length > 0
                ? b.projects.map((p, i) => <>{i > 0 && ', '}<a class="link" href={`/travaux/${p.id}`}>{p.data.title}</a></>)
                : 'Aucune fiche rattachée pour le moment'}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-bottom: var(--s-6); }
  .jump a { text-decoration: underline; text-decoration-color: var(--line-strong); }
  .jump a:hover { color: var(--accent); text-decoration-color: currentColor; }

  .domains { display: flex; flex-direction: column; gap: var(--s-7); }
  .domain { scroll-margin-top: calc(var(--header-h) + 1rem); }
  @media (min-width: 900px) { .domain.cols { grid-template-columns: 240px minmax(0, 1fr); gap: var(--s-7); } }
  .domain__intro h2 { font-size: var(--text-lg); margin-bottom: 0.3rem; }
  .domain__intro .meta { max-width: 30ch; }

  .skill { display: grid; grid-template-columns: 1fr; gap: 0.2rem var(--s-5); padding: 0.7rem 0; }
  @media (min-width: 640px) { .skill { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .skill__name { font-weight: 600; }
  .skill__note { display: block; }
  .skill__rel { padding-top: 0.1rem; }

  .blocs { margin: 0; border-top: 1px solid var(--line); }
  .bloc { padding: 0.75rem 0; border-bottom: 1px solid var(--line); display: grid; gap: 0.2rem var(--s-5); }
  @media (min-width: 640px) { .bloc { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .bloc dt { font-weight: 600; }
  .bloc__id { color: var(--accent); margin-right: 0.35rem; }
  .bloc dd { margin: 0; }
</style>
