---
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import { KINDS, type Kind } from '@/data/taxonomy';
import { getPresentationOrder, getProjectRef } from '@/lib/projects';
import { formatMonthCap } from '@/lib/format';

const order = await getPresentationOrder();
const refs = await Promise.all(order.map((p) => getProjectRef(p)));
const first = order[0];
---

<Base
  title="Mode présentation"
  description="Parcours guidé des travaux, pensé pour une présentation orale devant un jury : navigation au clavier entre fiches et sections."
  noindex
>
  <section class="section">
    <div class="container cols">
      <div>
        <div class="head" data-index="Lecture guidée">
          <h1>Mode présentation</h1>
          <p>Pour une présentation orale : la navigation est masquée, le texte est agrandi et le clavier permet de passer d’une section à l’autre. Ce n’est pas un diaporama, c’est le portfolio en lecture guidée.</p>
          {first && <p><a href={`/travaux/${first.id}?presentation`} class="btn">Démarrer avec la première fiche</a></p>}
        </div>

        {order.length > 0 ? (
          <ol class="rows" role="list">
            {order.map((p, i) => (
              <li class="pres row" data-reveal>
                <span class="mono pres__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="row-title"><a href={`/travaux/${p.id}?presentation`}>{p.data.title}</a></p>
                  <p class="meta">{refs[i]} · {KINDS[p.data.kind as Kind].label} · {formatMonthCap(p.data.date)}</p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <EmptyState title="Aucune fiche à présenter" text="Ajoutez des fiches de travaux pour alimenter le mode présentation." file="src/content/projects/" />
        )}
      </div>

      <aside class="help" data-reveal>
        <p class="kicker">Raccourcis clavier</p>
        <dl class="keys">
          <div><dt><kbd>↓</kbd> <kbd>Espace</kbd></dt><dd>Section suivante</dd></div>
          <div><dt><kbd>↑</kbd></dt><dd>Section précédente</dd></div>
          <div><dt><kbd>→</kbd></dt><dd>Fiche suivante</dd></div>
          <div><dt><kbd>←</kbd></dt><dd>Fiche précédente</dd></div>
          <div><dt><kbd>Échap</kbd></dt><dd>Quitter</dd></div>
        </dl>
        <p class="meta help__note">Ordre : les fiches <code>featured</code> d’abord (triées par <code>order</code>), puis les autres par date.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .head .btn { margin-top: var(--s-2); }
  .pres { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s-3); }
  .pres__num { color: var(--ink-3); padding-top: 0.2rem; }
  .keys { margin: 0; border-top: 1px solid var(--line); }
  .keys div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: var(--text-sm); }
  .keys dt { display: flex; gap: 0.25rem; }
  .keys dd { margin: 0; color: var(--ink-2); }
  kbd { font-size: 0.75rem; padding: 0.1rem 0.4rem; border: 1px solid var(--line-strong); border-bottom-width: 2px; border-radius: 3px; background: var(--bg-2); }
  .help__note { margin-top: var(--s-4); }
  @media (min-width: 900px) { .help { padding-top: 0.35rem; } }
</style>
