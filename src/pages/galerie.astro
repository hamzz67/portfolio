---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import Lightbox from '@/components/Lightbox.astro';
import { galleryItems } from '@/data/gallery';
import { CATEGORIES, type Category } from '@/data/taxonomy';
import { getProjects, getProjectRef } from '@/lib/projects';
import { formatMonthCap } from '@/lib/format';

interface Item {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

/**
 * Un dossier par fiche de travaux (couverture + images de la fiche, ajoutées
 * automatiquement), plus un dossier « Divers » pour les images libres de
 * src/assets/gallery/ déclarées dans src/data/gallery.ts.
 */
interface Folder {
  id: string;
  title: string;
  ref?: string;
  meta: string;
  href?: string;
  items: Item[];
}

const projects = await getProjects();
const folders: Folder[] = [];
for (const p of projects) {
  const d = p.data;
  const items: Item[] = [
    ...(d.cover ? [{ src: d.cover, alt: d.coverAlt ?? d.title, caption: d.coverAlt }] : []),
    ...d.images.filter((img) => img.src.src !== d.cover?.src).map((img) => ({ src: img.src, alt: img.alt, caption: img.caption })),
  ];
  if (items.length === 0) continue;
  folders.push({
    id: p.id,
    title: d.title,
    ref: await getProjectRef(p),
    meta: `${CATEGORIES[d.category as Category].label} · ${formatMonthCap(d.date)}`,
    href: `/travaux/${p.id}`,
    items,
  });
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true });
const loose: Item[] = galleryItems.flatMap((g) => {
  const mod = files[`/src/assets/gallery/${g.file}`];
  if (!mod) {
    console.warn(`[galerie] fichier introuvable : src/assets/gallery/${g.file}`);
    return [];
  }
  return [{ src: mod.default, alt: g.alt, caption: g.caption }];
});
if (loose.length) folders.push({ id: 'divers', title: 'Divers', meta: 'Schémas et images hors fiches', items: loose });

const total = folders.reduce((n, f) => n + f.items.length, 0);
---

<Base
  title="Galerie — captures, schémas et architectures"
  description="Galerie visuelle rangée par dossier : captures d’écran, configurations et schémas réseau issus des travaux de BTS SIO SISR et des projets personnels."
>
  <section class="section">
    <div class="container">
      <div class="head" data-index="Galerie">
        <h1>Galerie</h1>
        <p>{total} image{total > 1 ? 's' : ''} rangée{total > 1 ? 's' : ''} en {folders.length} dossier{folders.length > 1 ? 's' : ''}, un par travail. Chaque dossier renvoie à sa fiche.</p>
      </div>

      {folders.length > 0 ? (
        <div data-galerie>
          <nav class="drawer" aria-label="Dossiers de la galerie">
            <ul class="folders" role="list">
              {folders.map((f, i) => (
                <li data-reveal style={`--d:${i * 50}ms`}>
                  <a class="folder" href={`#${f.id}`} data-folder={f.id} aria-controls={f.id}>
                    <span class="folder__tab mono">{f.ref ?? 'DIV'}</span>
                    <span class="folder__stack" aria-hidden="true">
                      {f.items.slice(0, 3).reverse().map((it, k, arr) => (
                        <span class="folder__sheet" style={`--k:${arr.length - 1 - k}`}>
                          <Image src={it.src} alt="" width={320} widths={[320, 480]} sizes="240px" loading="lazy" />
                        </span>
                      ))}
                    </span>
                    <span class="folder__title">{f.title}</span>
                    <span class="folder__meta meta">{f.items.length} image{f.items.length > 1 ? 's' : ''} · {f.meta}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="drawer__all" hidden data-all-wrap>
              <button type="button" class="link" data-all>← Tous les dossiers</button>
            </p>
          </nav>

          {folders.map((f) => (
            <section class="dossier" id={f.id} aria-labelledby={`${f.id}-t`} data-dossier={f.id}>
              <header class="dossier__head">
                <p class="kicker">{f.ref ? `${f.ref} · ` : ''}{f.meta}</p>
                <h2 id={`${f.id}-t`}>{f.title}</h2>
                {f.href && <a class="link" href={f.href}>Lire la fiche →</a>}
              </header>
              <ul class="gallery" role="list">
                {f.items.map((item) => (
                  <li class="gallery__item">
                    <a href={item.src.src} class="gallery__link" data-lightbox data-caption={item.caption ?? item.alt} aria-label={`Agrandir : ${item.alt}`}>
                      <Image src={item.src} alt={item.alt} width={800} widths={[480, 800, 1200]} sizes="(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw" loading="lazy" />
                    </a>
                    {item.caption && <p class="meta">{item.caption}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState
          title="La galerie est vide pour le moment"
          text="Deux façons d’ajouter des images : le champ images d’une fiche de travail (ajout automatique), ou une image libre déposée dans src/assets/gallery/ et déclarée dans src/data/gallery.ts. Toujours anonymiser les captures avant publication."
          file="src/data/gallery.ts"
        />
      )}
    </div>
  </section>

  <Lightbox />

  <script>
    import { initLightbox } from '@/scripts/lightbox';

    /** Ouvre un dossier : les autres sont masqués, l'adresse garde l'ancre (lien partageable). */
    function initFolders() {
      const root = document.querySelector<HTMLElement>('[data-galerie]');
      if (!root) return;
      const links = root.querySelectorAll<HTMLAnchorElement>('[data-folder]');
      const dossiers = root.querySelectorAll<HTMLElement>('[data-dossier]');
      const allWrap = root.querySelector<HTMLElement>('[data-all-wrap]')!;

      const open = (id: string, scroll: boolean) => {
        const known = [...dossiers].some((d) => d.dataset.dossier === id);
        const target = known ? id : '';
        dossiers.forEach((d) => (d.hidden = !!target && d.dataset.dossier !== target));
        links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.folder === target)));
        root.toggleAttribute('data-open', !!target);
        allWrap.hidden = !target;
        if (target && scroll) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      links.forEach((l) =>
        l.addEventListener('click', (e) => {
          e.preventDefault();
          const id = l.dataset.folder!;
          const again = l.getAttribute('aria-current') === 'true';
          history.replaceState(null, '', again ? location.pathname : `#${id}`);
          open(again ? '' : id, !again);
        }),
      );
      root.querySelector('[data-all]')?.addEventListener('click', () => {
        history.replaceState(null, '', location.pathname);
        open('', false);
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      open(decodeURIComponent(location.hash.slice(1)), false);
    }

    document.addEventListener('astro:page-load', () => {
      initLightbox();
      initFolders();
    });
  </script>
</Base>

<style>
  .drawer { margin-bottom: var(--s-7); }
  .folders { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--s-6) var(--s-4); padding-top: var(--s-3); }

  /* Chemise cartonnée : onglet, feuilles qui dépassent, étiquette. */
  .folder {
    position: relative; display: grid; gap: var(--s-2); height: 100%;
    padding: var(--s-4); padding-top: var(--s-5);
    color: inherit; text-decoration: none;
    background: var(--bg-elev); border: 1px solid var(--line); border-radius: 0 var(--radius) var(--radius) var(--radius);
    transition: border-color var(--dur) var(--ease), transform var(--dur-slow) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out);
  }
  .folder__tab {
    position: absolute; left: -1px; bottom: 100%;
    padding: 0.25em 0.9em 0.2em; font-size: 10.5px; letter-spacing: 0.06em; color: var(--ink-3);
    background: var(--bg-elev); border: 1px solid var(--line); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .folder:hover, .folder:focus-visible { border-color: var(--line-strong); transform: translateY(-3px); box-shadow: 0 10px 24px -18px rgb(0 0 0 / 0.5); }
  .folder:hover .folder__tab, .folder:focus-visible .folder__tab { border-color: var(--line-strong); color: var(--ink); }
  .folder[aria-current='true'] { border-color: var(--accent); }
  .folder[aria-current='true'] .folder__tab { border-color: var(--accent); color: var(--accent); }

  .folder__stack { position: relative; display: block; aspect-ratio: 16 / 10; margin: 10px 16px var(--s-2) 0; }
  .folder__sheet {
    position: absolute; inset: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 2px; background: var(--bg-2);
    transform: translate(calc(var(--k) * 6px), calc(var(--k) * -6px)) rotate(calc(var(--k) * 1.4deg));
    transform-origin: bottom left;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .folder__sheet :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .folder:hover .folder__sheet { transform: translate(calc(var(--k) * 12px), calc(var(--k) * -10px)) rotate(calc(var(--k) * 3deg)); }
  .folder__title { font-weight: 600; line-height: 1.3; }
  .folder__meta { align-self: end; }

  .drawer__all { margin-top: var(--s-5); }
  .drawer__all button { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }

  .dossier { scroll-margin-top: calc(var(--header-h) + var(--s-4)); padding-top: var(--s-6); border-top: 1px solid var(--line); margin-top: var(--s-6); }
  .dossier__head { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); }
  .dossier__head h2 { font-size: var(--text-xl); font-stretch: var(--display-stretch); }

  .gallery { columns: 1; column-gap: var(--s-4); }
  @media (min-width: 640px) { .gallery { columns: 2; } }
  @media (min-width: 900px) { .gallery { columns: 3; } }
  .gallery__item { break-inside: avoid; margin-bottom: var(--s-5); }
  .gallery__link { display: block; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .gallery__link:hover { border-color: var(--line-strong); }
  .gallery__item p { margin-top: 0.4rem; }

  @media (prefers-reduced-motion: reduce) {
    .folder, .folder__sheet { transition: none; }
    .folder:hover { transform: none; }
  }
</style>
