---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import EmptyState from '@/components/EmptyState.astro';
import Lightbox from '@/components/Lightbox.astro';
import { galleryItems, galleryCategories } from '@/data/gallery';
import { getProjects } from '@/lib/projects';

interface Item {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  category: string;
  source?: { title: string; href: string };
}

/* Images « libres » : src/assets/gallery/ + liste dans src/data/gallery.ts */
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true });
const standalone: Item[] = galleryItems.flatMap((g) => {
  const mod = files[`/src/assets/gallery/${g.file}`];
  if (!mod) {
    console.warn(`[galerie] fichier introuvable : src/assets/gallery/${g.file}`);
    return [];
  }
  return [{ src: mod.default, alt: g.alt, caption: g.caption, category: g.category }];
});

/* Images des fiches (ajoutées automatiquement) */
const projects = await getProjects();
const fromProjects: Item[] = projects.flatMap((p) =>
  p.data.images.map((img) => ({ src: img.src, alt: img.alt, caption: img.caption, category: 'capture', source: { title: p.data.title, href: `/travaux/${p.id}` } })),
);

const items = [...fromProjects, ...standalone];
const usedCategories = Object.entries(galleryCategories).filter(([key]) => items.some((i) => i.category === key));
---

<Base
  title="Galerie — captures, schémas et architectures"
  description="Galerie visuelle : captures d’écran, schémas réseau, architectures et interfaces issus des travaux de BTS SIO SISR et des projets personnels."
>
  <section class="section">
    <div class="container">
      <div class="head">
        <h1>Galerie</h1>
        <p>{items.length} image{items.length > 1 ? 's' : ''} : captures d’écran, schémas et architectures. Les images des fiches de travaux sont ajoutées automatiquement.</p>
      </div>

      {items.length > 0 ? (
        <>
          {usedCategories.length > 1 && (
            <div class="tags gfilters" role="group" aria-label="Filtrer la galerie">
              <button type="button" class="tag tag--active" data-gfilter="" aria-pressed="true">Tout</button>
              {usedCategories.map(([key, label]) => <button type="button" class="tag" data-gfilter={key} aria-pressed="false">{label}</button>)}
            </div>
          )}

          <ul class="gallery" role="list" data-gallery>
            {items.map((item) => (
              <li class="gallery__item" data-category={item.category}>
                <a href={item.src.src} class="gallery__link" data-lightbox data-caption={item.caption ?? item.alt} aria-label={`Agrandir : ${item.alt}`}>
                  <Image src={item.src} alt={item.alt} width={800} widths={[480, 800, 1200]} sizes="(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw" loading="lazy" />
                </a>
                <p class="meta">
                  {item.caption ?? item.alt}
                  {item.source && <> · <a class="link" href={item.source.href}>{item.source.title}</a></>}
                </p>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <EmptyState
          title="La galerie est vide pour le moment"
          text="Deux façons d’ajouter des images : le champ images d’une fiche de travail (ajout automatique), ou une image libre déposée dans src/assets/gallery/ et déclarée dans src/data/gallery.ts. Toujours anonymiser les captures avant publication."
          file="src/data/gallery.ts"
        />
      )}
    </div>
  </section>

  <Lightbox />

  <script>
    import { initLightbox } from '@/scripts/lightbox';
    document.addEventListener('astro:page-load', () => {
      initLightbox();
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-gfilter]');
      const items = document.querySelectorAll<HTMLElement>('[data-gallery] > li');
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const v = b.dataset.gfilter ?? '';
          buttons.forEach((o) => {
            const on = o === b;
            o.classList.toggle('tag--active', on);
            o.setAttribute('aria-pressed', String(on));
          });
          items.forEach((it) => (it.hidden = !!v && it.dataset.category !== v));
        }),
      );
    });
  </script>
</Base>

<style>
  .gfilters { margin-bottom: var(--s-5); }
  .gfilters button { cursor: pointer; }
  .gallery { columns: 1; column-gap: var(--s-4); }
  @media (min-width: 640px) { .gallery { columns: 2; } }
  @media (min-width: 900px) { .gallery { columns: 3; } }
  .gallery__item { break-inside: avoid; margin-bottom: var(--s-5); }
  .gallery__link { display: block; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .gallery__link:hover { border-color: var(--line-strong); }
  .gallery__item p { margin-top: 0.4rem; }
</style>
