---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { CATEGORIES, KINDS, kindKeys, categoryKeys } from '@/data/taxonomy';
import { getProjects, getAllTechnologies, getAllYears, getAllContexts } from '@/lib/projects';
import { slugify } from '@/lib/format';

const projects = await getProjects();
const technologies = await getAllTechnologies();
const years = await getAllYears();
const contexts = await getAllContexts();
const usedCategories = categoryKeys.filter((c) => projects.some((p) => p.data.category === c || p.data.categories.includes(c)));
const countByKind = Object.fromEntries(kindKeys.map((k) => [k, projects.filter((p) => p.data.kind === k).length]));
const plural = (n: number, w: string) => `${n} ${w}${n > 1 ? 's' : ''}`;
---

<Base
  title="Travaux — TP, stage et projets"
  description="Bibliothèque de travaux de BTS SIO SISR : TP réseau et systèmes, stage, projets personnels. Filtrables par domaine, technologie, année et contexte."
>
  <section class="section">
    <div class="container">
      <div class="head" data-index="Bibliothèque">
        <h1>Travaux</h1>
        <p>{plural(projects.length, 'fiche')} publiée{projects.length > 1 ? 's' : ''} : travaux de BTS, stage et projets personnels. Chaque fiche décrit le contexte, la démarche, les difficultés rencontrées et le résultat.</p>
      </div>

      <div class="lib" data-filters>
        <div class="lib__bar">
          <label class="search">
            <Icon name="search" size={16} />
            <span class="sr-only">Rechercher un travail</span>
            <input type="search" name="q" placeholder="Rechercher (vlan, linux, cisco…)" autocomplete="off" data-search-input />
          </label>
          <p class="meta" data-count aria-live="polite">{plural(projects.length, 'résultat')}</p>
          <button type="button" class="btn btn--secondary btn--sm lib__toggle" data-filters-toggle aria-expanded="false" aria-controls="filters-panel">
            <Icon name="filter" size={13} /> Filtres
          </button>
        </div>
        <p class="lib__egg mono" data-egg hidden aria-live="polite"></p>

        <div class="lib__layout">
          <aside class="filters" id="filters-panel">
            <div class="filters__group">
              <p class="kicker">Nature</p>
              <div class="tags" role="group" aria-label="Nature">
                <button type="button" class="tag tag--active" data-filter="kind" data-value="" aria-pressed="true">Tous ({projects.length})</button>
                {kindKeys.map((k) => (
                  <button type="button" class="tag" data-filter="kind" data-value={k} aria-pressed="false">{KINDS[k].short} ({countByKind[k]})</button>
                ))}
              </div>
            </div>

            {usedCategories.length > 0 && (
              <div class="filters__group">
                <p class="kicker">Domaine</p>
                <div class="tags" role="group" aria-label="Domaine">
                  {usedCategories.map((c) => (
                    <button type="button" class="tag" data-filter="category" data-value={c} aria-pressed="false">{CATEGORIES[c].label}</button>
                  ))}
                </div>
              </div>
            )}

            {technologies.length > 0 && (
              <div class="filters__group">
                <p class="kicker">Technologie</p>
                <div class="tags" role="group" aria-label="Technologie">
                  {technologies.map((t) => (
                    <button type="button" class="tag" data-filter="tech" data-value={slugify(t)} aria-pressed="false">{t}</button>
                  ))}
                </div>
              </div>
            )}

            {(years.length > 0 || contexts.length > 0) && (
              <div class="filters__row">
                {years.length > 0 && (
                  <label class="filters__select">
                    <span class="kicker">Année</span>
                    <select data-filter-select="year">
                      <option value="">Toutes</option>
                      {years.map((y) => <option value={y}>{y}</option>)}
                    </select>
                  </label>
                )}
                {contexts.length > 0 && (
                  <label class="filters__select">
                    <span class="kicker">Contexte</span>
                    <select data-filter-select="context">
                      <option value="">Tous</option>
                      {contexts.map((c) => <option value={slugify(c)}>{c}</option>)}
                    </select>
                  </label>
                )}
              </div>
            )}

            <button type="button" class="filters__reset link" data-filters-reset hidden>Réinitialiser les filtres</button>
          </aside>

          <div class="lib__results">
            {projects.length > 0 ? (
              <>
                <ul class="rows" role="list" data-results>
                  {projects.map((p) => <li><ProjectCard project={p} /></li>)}
                </ul>
                <div data-empty hidden>
                  <EmptyState title="Aucune fiche ne correspond à ces critères" text="Essayez un autre mot-clé ou retirez un filtre.">
                    <p style="margin-top:0.6rem"><button type="button" class="link" data-filters-reset>Réinitialiser les filtres</button></p>
                  </EmptyState>
                </div>
              </>
            ) : (
              <EmptyState
                title="La bibliothèque est vide pour le moment"
                text="Les TP et projets seront ajoutés au fil de la formation. Pour ajouter une fiche, copiez _TEMPLATE.md dans le dossier des projets."
                file="src/content/projects/"
              />
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initFilters } from '@/scripts/filters';
    document.addEventListener('astro:page-load', initFilters);
  </script>
</Base>

<style>
  .lib__bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-4); margin-bottom: var(--s-5); }
  .search {
    flex: 1 1 280px; display: flex; align-items: center; gap: 0.6rem;
    padding: 0 0.75rem; min-height: 2.5rem;
    border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--bg);
    color: var(--ink-3);
  }
  .search:focus-within { border-color: var(--accent); color: var(--accent); }
  .search input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); outline: none; font-size: var(--text-sm); }
  .search input::placeholder { color: var(--ink-3); }
  .search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .lib__egg { margin: calc(var(--s-4) * -1) 0 var(--s-4); color: var(--accent); }

  .lib__layout { display: grid; gap: var(--s-5); align-items: start; }
  @media (min-width: 880px) {
    .lib__layout { grid-template-columns: 220px minmax(0, 1fr); gap: var(--s-7); }
    .lib__toggle { display: none; }
    .filters { display: flex !important; position: sticky; top: calc(var(--header-h) + 1rem); }
  }
  .filters { display: none; flex-direction: column; gap: var(--s-5); }
  .filters.is-open { display: flex; }
  .filters button.tag { cursor: pointer; }
  .filters__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .filters__select { display: flex; flex-direction: column; min-width: 0; }
  .filters__select select {
    width: 100%; min-height: 2.25rem; padding: 0 0.5rem;
    border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: var(--bg); color: var(--ink); font-size: var(--text-sm);
  }
  .filters__reset { align-self: flex-start; font-size: var(--text-sm); }
  .lib__results { min-width: 0; }
  .lib__results li[hidden] { display: none; }
  .lib__results li:last-child :global(.work) { border-bottom: 0; }
  .rows li:last-child { border-bottom: 1px solid var(--line); }
</style>
