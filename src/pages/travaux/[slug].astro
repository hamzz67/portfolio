---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Lightbox from '@/components/Lightbox.astro';
import { CATEGORIES, KINDS, STATUSES, BTS_BLOCS, type Category, type Kind, type Status, type BtsBloc } from '@/data/taxonomy';
import { getProjects, getProjectRef, getNeighbours, getPresentationOrder } from '@/lib/projects';
import { formatMonthCap, isoDate, slugify } from '@/lib/format';
import { profile } from '@/data/profile';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const ref = await getProjectRef(project);
const { prev, next } = await getNeighbours(project);
const order = await getPresentationOrder();
const position = order.findIndex((p) => p.id === project.id) + 1;

const kind = KINDS[d.kind as Kind];
const category = CATEGORIES[d.category as Category];
const status = STATUSES[d.status as Status];
const period = d.endDate ? `${formatMonthCap(d.date)} → ${formatMonthCap(d.endDate)}` : formatMonthCap(d.date);
const isTodo = (v?: string) => !!v && v.toUpperCase().startsWith('TODO');
const stripTodo = (v: string) => v.replace(/^TODO\s*[—-]?\s*/i, '');

const meta = [
  { label: 'Nature', value: kind.label },
  { label: 'Domaine', value: [category.label, ...d.categories.map((c) => CATEGORIES[c as Category].label)].join(', ') },
  { label: 'Période', value: period },
  { label: 'Contexte', value: d.context },
  { label: 'Organisation', value: d.organization },
  { label: 'Rôle', value: d.role },
  { label: 'Statut', value: status.label },
].filter((m) => m.value);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: profile.name },
  dateCreated: isoDate(d.date),
  keywords: [...d.technologies, ...d.skills].join(', '),
  inLanguage: 'fr',
};
---

<Base title={d.title} description={d.summary} type="article" jsonLd={jsonLd} image={d.cover ? d.cover.src : undefined}>
  <article class="fiche" data-presentation-root data-position={position} data-total={order.length}>
    <header class="fiche__head">
      <div class="grid-bg"></div>
      <div class="container fiche__head-inner">
        <p class="fiche__crumb meta rise"><a href="/travaux">Travaux</a> / {kind.plural} / <span class="mono">{ref}</span></p>
        <h1 class="fiche__title rise" style="--d:80ms" transition:name={`title-${project.id}`}>{d.title}</h1>
        <p class="fiche__summary rise" style="--d:180ms">{d.summary}</p>
        <div class="fiche__actions rise" style="--d:280ms">
          <button type="button" class="btn btn--secondary btn--sm" data-presentation-start>
            <Icon name="presentation" size={14} /> Présenter cette fiche
          </button>
          {d.links.github && <a href={d.links.github} class="btn btn--secondary btn--sm" target="_blank" rel="noopener"><Icon name="github" size={14} /> Code source</a>}
          {d.links.demo && <a href={d.links.demo} class="btn btn--secondary btn--sm" target="_blank" rel="noopener">Démonstration <Icon name="arrow-up-right" size={13} /></a>}
        </div>
      </div>
    </header>

    {d.cover && (
      <div class="container fiche__cover">
        <Image src={d.cover} alt={d.coverAlt ?? ''} width={1600} widths={[720, 1200, 1600]} sizes="(min-width: 1080px) 1040px, 100vw" loading="eager" fetchpriority="high" transition:name={`cover-${project.id}`} />
      </div>
    )}

    <div class="container fiche__body">
      <aside class="fiche__side">
        <div class="fiche__sticky">
          <dl class="facts">
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{isTodo(m.value) ? <><span class="todo">TODO</span> <span class="meta">{stripTodo(m.value!)}</span></> : m.value}</dd>
              </div>
            ))}
            <div>
              <dt>Technologies</dt>
              <dd>
                {d.technologies.length > 0 ? (
                  <span class="tags">{d.technologies.map((t) => <a class="tag" href={`/travaux?tech=${slugify(t)}`}>{t}</a>)}</span>
                ) : (
                  <span class="meta"><span class="todo">TODO</span> à renseigner dans l’en-tête</span>
                )}
              </dd>
            </div>
            {d.skills.length > 0 && (
              <div>
                <dt>Compétences</dt>
                <dd>{d.skills.join(', ')}</dd>
              </div>
            )}
            {d.bts.length > 0 && (
              <div>
                <dt>Référentiel BTS</dt>
                <dd>
                  {d.bts.map((b) => <span class="fiche__bloc"><span class="mono">{b}</span> {BTS_BLOCS[b as BtsBloc].label}</span>)}
                </dd>
              </div>
            )}
            {d.documents.length > 0 && (
              <div>
                <dt>Documents</dt>
                <dd>
                  <ul class="fiche__docs" role="list">
                    {d.documents.map((doc) => (
                      <li><a class="link" href={doc.href} target="_blank" rel="noopener">{doc.label}</a> <span class="meta">({doc.type})</span></li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>

          {toc.length > 0 && (
            <nav class="toc" aria-label="Sommaire de la fiche" data-toc>
              <p class="kicker">Sommaire</p>
              <ol role="list">
                {toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>)}
              </ol>
            </nav>
          )}

          {import.meta.env.DEV && !d.publicSafe && (
            <p class="meta"><span class="todo">DEV</span> fiche non marquée <code>publicSafe: true</code> — relire CONTENT-SAFETY.md avant publication.</p>
          )}
        </div>
      </aside>

      <div class="fiche__main">
        <div class="prose" data-presentation-content>
          <Content />
        </div>

        {d.images.length > 0 && (
          <section class="fiche__gallery" aria-labelledby="gal-title">
            <h2 id="gal-title">Captures et schémas</h2>
            <ul class="fgrid" role="list">
              {d.images.map((img) => (
                <li>
                  <a href={img.src.src} class="fgrid__item" data-lightbox data-caption={img.caption ?? img.alt} aria-label={`Agrandir : ${img.alt}`}>
                    <Image src={img.src} alt={img.alt} width={800} widths={[480, 800]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
                  </a>
                  {img.caption && <p class="meta">{img.caption}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    <nav class="container fiche__nav" aria-label="Fiches voisines">
      {prev ? (
        <a href={`/travaux/${prev.id}`} class="fiche__nav-link" data-nav-prev rel="prev">
          <span class="meta">← Fiche précédente</span>
          <span>{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/travaux/${next.id}`} class="fiche__nav-link fiche__nav-link--next" data-nav-next rel="next">
          <span class="meta">Fiche suivante →</span>
          <span>{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>

    <!-- Barre du mode présentation -->
    <div class="pbar" data-presentation-bar hidden>
      <div class="pbar__inner">
        <span class="mono pbar__ref">{ref}</span>
        <span class="pbar__pos meta"><span data-presentation-section>—</span></span>
        <span class="pbar__group">
          <button type="button" class="pbar__btn" data-presentation-section-prev aria-label="Section précédente (↑)"><Icon name="chevron-left" size={16} /></button>
          <button type="button" class="pbar__btn" data-presentation-section-next aria-label="Section suivante (↓ ou espace)"><Icon name="chevron-right" size={16} /></button>
        </span>
        <span class="meta pbar__fiche">Fiche {position}/{order.length}</span>
        <span class="pbar__group">
          {prev && <a href={`/travaux/${prev.id}`} class="pbar__btn" aria-label="Fiche précédente (←)"><Icon name="arrow-left" size={16} /></a>}
          {next && <a href={`/travaux/${next.id}`} class="pbar__btn" aria-label="Fiche suivante (→)"><Icon name="arrow-right" size={16} /></a>}
        </span>
        <button type="button" class="pbar__btn pbar__exit" data-presentation-exit aria-label="Quitter le mode présentation (Échap)"><Icon name="x" size={16} /> <span>Quitter</span></button>
      </div>
    </div>
  </article>

  <Lightbox />

  <script>
    import { initPresentation } from '@/scripts/presentation';
    import { initLightbox } from '@/scripts/lightbox';
    import { initToc } from '@/scripts/toc';
    document.addEventListener('astro:page-load', () => {
      initPresentation();
      initLightbox();
      initToc();
    });
  </script>
</Base>

<style>
  .fiche__head { position: relative; overflow: hidden; padding-block: var(--s-7) var(--s-6); border-bottom: 1px solid var(--line); }
  .fiche__head :global(.grid-bg) {
    -webkit-mask-image: radial-gradient(ellipse 60% 100% at 90% 50%, #000 10%, transparent 80%);
    mask-image: radial-gradient(ellipse 60% 100% at 90% 50%, #000 10%, transparent 80%);
  }
  .fiche__head-inner { position: relative; z-index: 1; }
  .fiche__crumb { margin-bottom: var(--s-4); }
  .fiche__crumb a:hover { color: var(--accent); text-decoration: underline; }
  .fiche__title { font-size: var(--text-3xl); max-width: 26ch; }
  .fiche__summary { margin-top: var(--s-3); max-width: var(--measure); font-size: var(--text-md); color: var(--ink-2); }
  .fiche__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--s-5); }

  .fiche__cover { padding-top: var(--s-6); }
  .fiche__cover :global(img) { width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius); }

  .fiche__body { display: grid; gap: var(--s-6); padding-block: var(--s-6) var(--s-7); align-items: start; }
  @media (min-width: 900px) {
    .fiche__body { grid-template-columns: 260px minmax(0, 1fr); gap: var(--s-8); }
    .fiche__sticky { position: sticky; top: calc(var(--header-h) + 1.25rem); }
  }
  .fiche__sticky { display: flex; flex-direction: column; gap: var(--s-5); }

  .facts { margin: 0; border-top: 1px solid var(--line); }
  .facts div { padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: var(--text-xs); font-weight: 500; color: var(--ink-3); margin-bottom: 0.15rem; }
  .facts dd { margin: 0; font-size: var(--text-sm); line-height: 1.5; }
  .fiche__bloc { display: block; }
  .fiche__bloc .mono { color: var(--accent); margin-right: 0.3rem; }
  .fiche__docs li + li { margin-top: 0.2rem; }

  .toc ol { display: flex; flex-direction: column; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 0.25rem 0 0.25rem 0.75rem; margin-left: -1px; border-left: 1px solid transparent; font-size: var(--text-sm); color: var(--ink-2); }
  .toc a:hover { color: var(--ink); }
  .toc a.is-active { color: var(--accent); border-left-color: var(--accent); }

  .fiche__main { min-width: 0; }
  .fiche__gallery { margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .fiche__gallery h2 { font-size: var(--text-lg); margin-bottom: var(--s-4); }
  .fgrid { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .fgrid__item { display: block; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .fgrid__item:hover { border-color: var(--line-strong); }
  .fgrid li p { margin-top: 0.4rem; }

  .fiche__nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .fiche__nav-link { display: flex; flex-direction: column; gap: 0.2rem; font-weight: 500; }
  .fiche__nav-link:hover > span:last-child { color: var(--accent); text-decoration: underline; }
  .fiche__nav-link--next { text-align: right; align-items: flex-end; }
  @media (max-width: 560px) { .fiche__nav { grid-template-columns: 1fr; } .fiche__nav-link--next { text-align: left; align-items: flex-start; } }

  /* Mode présentation */
  .pbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 150; padding: 0 var(--gutter) max(0.75rem, env(safe-area-inset-bottom)); pointer-events: none; }
  .pbar__inner {
    pointer-events: auto; margin-inline: auto; max-width: 760px;
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    padding: 0.4rem 0.6rem; background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--radius);
    box-shadow: 0 6px 24px -12px rgb(0 0 0 / 0.35);
  }
  .pbar__pos { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pbar__group { display: flex; gap: 0.1rem; }
  .pbar__btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem; min-width: 2rem; height: 2rem; padding: 0 0.4rem; border-radius: var(--radius); color: var(--ink-2); font-size: var(--text-xs); }
  .pbar__btn:hover { background: var(--bg-2); color: var(--ink); }
  .pbar__exit { border: 1px solid var(--line); }
  @media (max-width: 640px) { .pbar__ref, .pbar__fiche { display: none; } .pbar__exit span { display: none; } }

  :global(body[data-presenting]) .fiche__main .prose { font-size: var(--text-lg); max-width: 74ch; }
  :global(body[data-presenting]) .fiche__main .prose h2 { font-size: var(--text-xl); scroll-margin-top: 2.5rem; }
  :global(body[data-presenting]) .fiche__main .prose h2.is-current { color: var(--accent); }
  :global(body[data-presenting]) .fiche__nav,
  :global(body[data-presenting]) .fiche__crumb,
  :global(body[data-presenting]) [data-presentation-start] { display: none; }
  :global(body[data-presenting]) { padding-bottom: 4.5rem; }
  :global(body[data-presenting] #site-header),
  :global(body[data-presenting] .footer) { display: none; }
</style>
