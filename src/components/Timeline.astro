---
import { timeline, resolveStatus } from '@/data/timeline';

interface Props {
  /** Version courte (accueil) : sans les descriptions. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<ol class="tl" role="list">
  {timeline.map((item, i) => {
    const status = resolveStatus(item);
    return (
      <li class:list={['tl__item', `tl__item--${status}`]} data-reveal style={`--i:${i}`}>
        <time class="tl__date mono" datetime={item.iso}>{item.date}</time>
        <span class="tl__dot" aria-hidden="true"></span>
        <div class="tl__body">
          <p class="tl__title">
            {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            {status === 'current' && <span class="tl__badge">en cours</span>}
            {status === 'planned' && <span class="tl__badge tl__badge--planned">prévu</span>}
          </p>
          {item.place && <p class="meta">{item.place}</p>}
          {!compact && item.description && <p class="tl__desc">{item.description}</p>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .tl { position: relative; display: flex; flex-direction: column; }
  /* Fil vertical, tracé au défilement */
  .tl::before {
    content: ''; position: absolute; top: 0.6rem; bottom: 0.6rem; left: 4px; width: 1px;
    background: var(--line-strong);
    transform: scaleY(0); transform-origin: top;
    transition: transform 1.2s var(--ease-out) 150ms;
  }
  .tl:has(.is-in)::before { transform: scaleY(1); }
  @media (min-width: 640px) { .tl::before { left: calc(8.5rem + var(--s-5) - 4px); } }

  .tl__item {
    position: relative;
    display: grid; grid-template-columns: 1fr; gap: 0.2rem var(--s-5);
    padding: var(--s-4) 0 var(--s-4) 1.4rem;
  }
  @media (min-width: 640px) {
    .tl__item { grid-template-columns: 8.5rem minmax(0, 1fr); padding-left: 0; }
    .tl__body { padding-left: 1.4rem; }
  }
  .tl__dot {
    position: absolute; top: calc(var(--s-4) + 0.42rem); left: 0;
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--bg); border: 1.5px solid var(--line-strong);
    transition: border-color var(--dur), background var(--dur), transform var(--dur) var(--ease-out);
  }
  @media (min-width: 640px) { .tl__dot { left: calc(8.5rem + var(--s-5) - 8px); } }
  .tl__item--done .tl__dot { background: var(--ink); border-color: var(--ink); }
  .tl__item--current .tl__dot { background: var(--accent); border-color: var(--accent); }
  .tl__item--current .tl__dot::after {
    content: ''; position: absolute; inset: -1.5px; border-radius: 50%;
    border: 1.5px solid var(--accent);
    animation: tl-ping 2.4s var(--ease-out) infinite;
  }
  @keyframes tl-ping { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(3); opacity: 0; } }
  .tl__item:hover .tl__dot { transform: scale(1.35); }

  .tl__date { color: var(--ink-3); padding-top: 0.2rem; }
  .tl__item--current .tl__date { color: var(--accent); font-weight: 500; }
  .tl__item--planned .tl__date, .tl__item--planned .tl__title { color: var(--ink-3); }
  .tl__title { font-weight: 600; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .tl__title a { transition: color var(--dur); }
  .tl__title a:hover { color: var(--accent); }
  .tl__badge { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500; color: var(--accent); }
  .tl__badge--planned { color: var(--ink-3); }
  .tl__desc { margin-top: 0.25rem; color: var(--ink-2); font-size: var(--text-sm); max-width: 56ch; }
</style>
