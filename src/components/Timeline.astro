---
import { timeline, resolveStatus } from '@/data/timeline';

interface Props {
  /** Version courte (accueil) : sans les descriptions. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<ol class="tl" role="list">
  {timeline.map((item) => {
    const status = resolveStatus(item);
    return (
      <li class:list={['tl__item', `tl__item--${status}`]}>
        <time class="tl__date mono" datetime={item.iso}>{item.date}</time>
        <div class="tl__body">
          <p class="tl__title">
            {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            {status === 'current' && <span class="tl__badge">en cours</span>}
            {status === 'planned' && <span class="tl__badge tl__badge--planned">prévu</span>}
          </p>
          {item.place && <p class="meta">{item.place}</p>}
          {!compact && item.description && <p class="tl__desc">{item.description}</p>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .tl { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .tl__item {
    display: grid; grid-template-columns: 1fr; gap: 0.2rem var(--s-5);
    padding: var(--s-4) 0; border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) { .tl__item { grid-template-columns: 8.5rem minmax(0, 1fr); } }
  .tl__date { color: var(--ink-3); padding-top: 0.15rem; }
  .tl__item--current .tl__date { color: var(--accent); font-weight: 500; }
  .tl__item--planned .tl__date, .tl__item--planned .tl__title { color: var(--ink-3); }
  .tl__title { font-weight: 600; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .tl__title a:hover { color: var(--accent); text-decoration: underline; }
  .tl__badge { font-size: var(--text-xs); font-weight: 500; color: var(--accent); }
  .tl__badge--planned { color: var(--ink-3); }
  .tl__desc { margin-top: 0.25rem; color: var(--ink-2); font-size: var(--text-sm); max-width: 56ch; }
</style>
