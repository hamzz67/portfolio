---
import Icon from '@/components/Icon.astro';
import { profile } from '@/data/profile';

const nav = [
  { href: '/travaux', label: 'Travaux' },
  { href: '/parcours', label: 'Parcours' },
  { href: '/competences', label: 'Compétences' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/documents', label: 'Documents' },
  { href: '/#contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/#contact' && (path === href || path.startsWith(href + '/'));
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="header__brand">
      <span class="header__name">{profile.name}</span>
      <span class="header__role">BTS SIO SISR</span>
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__tools">
      <a href="/presentation" class="header__tool" title="Mode présentation" aria-label="Mode présentation">
        <Icon name="presentation" size={17} />
      </a>
      <button class="header__tool" type="button" data-theme-toggle aria-label="Changer de thème" title="Changer de thème">
        <Icon name="sun" size={17} class="theme-icon theme-icon--sun" />
        <Icon name="moon" size={17} class="theme-icon theme-icon--moon" />
      </button>
      <button class="header__tool header__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
        <Icon name="menu" size={19} class="burger-open" />
        <Icon name="x" size={19} class="burger-close" />
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" hidden>
    <nav aria-label="Navigation mobile" class="container">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href="/presentation">Mode présentation</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); height: var(--header-h); }
  .header__brand { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
  .header__name { font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .header__role { font-size: var(--text-xs); color: var(--ink-3); white-space: nowrap; }

  .header__nav { display: none; }
  .header__nav ul { display: flex; gap: 0.25rem; }
  .header__nav a {
    display: inline-block; padding: 0.35rem 0.6rem;
    font-size: var(--text-sm); color: var(--ink-2);
    border-radius: var(--radius);
    transition: color var(--dur), background var(--dur);
  }
  .header__nav a:hover { color: var(--ink); background: var(--bg-2); }
  .header__nav a[aria-current='page'] { color: var(--ink); font-weight: 500; box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }

  .header__tools { display: flex; align-items: center; gap: 0.15rem; }
  .header__tool {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border-radius: var(--radius);
    color: var(--ink-2); transition: color var(--dur), background var(--dur);
  }
  .header__tool:hover { color: var(--ink); background: var(--bg-2); }

  .header__tool :global(.theme-icon--moon) { display: block; }
  .header__tool :global(.theme-icon--sun) { display: none; }
  :global(:root[data-theme='dark']) .header__tool :global(.theme-icon--moon) { display: none; }
  :global(:root[data-theme='dark']) .header__tool :global(.theme-icon--sun) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .header__tool :global(.theme-icon--moon) { display: none; }
    :global(:root:not([data-theme='light'])) .header__tool :global(.theme-icon--sun) { display: block; }
  }
  .header__burger :global(.burger-close) { display: none; }
  .header__burger[aria-expanded='true'] :global(.burger-open) { display: none; }
  .header__burger[aria-expanded='true'] :global(.burger-close) { display: block; }

  .menu { border-top: 1px solid var(--line); background: var(--bg); padding-block: var(--s-3); }
  .menu ul { display: flex; flex-direction: column; }
  .menu a { display: block; padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-size: var(--text-md); }
  .menu li:last-child a { border-bottom: 0; }
  .menu a[aria-current='page'] { color: var(--accent); }

  @media (min-width: 880px) {
    .header__nav { display: block; }
    .header__burger { display: none; }
    .menu { display: none !important; }
  }
</style>
