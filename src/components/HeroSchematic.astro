---
/**
 * Illustration de la hero : schéma d'infrastructure stylisé (plan technique).
 * Les traits se dessinent à l'arrivée, quelques « paquets » circulent ensuite.
 * Purement décoratif (aria-hidden) ; tout est désactivé avec prefers-reduced-motion.
 */
const edges = [
  { id: 'e1', d: 'M120 78 H262', delay: 0.2 },
  { id: 'e2', d: 'M300 112 V168', delay: 0.5 },
  { id: 'e3', d: 'M300 232 V296', delay: 0.8 },
  { id: 'e4', d: 'M268 200 H210 Q160 200 160 250 V296', delay: 0.9 },
  { id: 'e5', d: 'M332 200 H390 Q440 200 440 250 V296', delay: 1.0 },
  { id: 'e6', d: 'M332 214 H470 Q500 214 500 244', delay: 1.1 },
  { id: 'e7', d: 'M160 364 V400 M300 364 V400 M440 364 V400', delay: 1.4 },
  { id: 'e8', d: 'M136 400 H184 M276 400 H324 M416 400 H464', delay: 1.6 },
];
const hosts = [136, 160, 184, 276, 300, 324, 416, 440, 464];
---

<svg class="schema" viewBox="0 0 600 460" aria-hidden="true" data-pointer>
  <defs>
    <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="1" />
    </pattern>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="var(--line-soft)" stroke-width="1" />
    </pattern>
  </defs>

  <!-- quadrillage et repères -->
  <rect class="schema__grid" x="0" y="0" width="600" height="460" fill="url(#grid)" />
  <g class="schema__marks" stroke="var(--ink-3)" stroke-width="1">
    <path d="M8 20V8H20M580 8h12v12M592 440v12h-12M20 452H8v-12" fill="none" />
  </g>

  <!-- liaisons -->
  <g class="schema__edges" fill="none" stroke="var(--ink-2)" stroke-width="1.25">
    {edges.map((e) => <path d={e.d} pathLength="1" class="schema__edge" style={`--d:${e.delay}s`} />)}
  </g>

  <!-- paquets en circulation -->
  <g class="schema__packets">
    <circle r="3" class="schema__packet" style="offset-path: path('M120 78 H262 Q300 78 300 112 V168'); --dur: 4.5s; --delay: 2.2s" />
    <circle r="3" class="schema__packet" style="offset-path: path('M300 232 V296'); --dur: 2.4s; --delay: 3.4s" />
    <circle r="3" class="schema__packet" style="offset-path: path('M332 214 H470 Q500 214 500 244'); --dur: 3.2s; --delay: 4.1s" />
  </g>

  <!-- nœuds -->
  <g class="schema__nodes" stroke="var(--ink)" stroke-width="1.25" fill="var(--paper-elev)">
    <!-- WAN -->
    <g class="schema__node" style="--d:0s">
      <rect x="40" y="56" width="80" height="44" rx="22" stroke-dasharray="3 4" />
      <text x="80" y="82" class="schema__label">WAN</text>
    </g>
    <!-- Pare-feu -->
    <g class="schema__node" style="--d:0.35s">
      <rect x="262" y="60" width="76" height="52" rx="3" />
      <rect x="262" y="60" width="76" height="52" rx="3" fill="url(#hatch)" class="schema__hatch" stroke="none" />
      <text x="300" y="91" class="schema__label">FW</text>
    </g>
    <!-- Cœur -->
    <g class="schema__node" style="--d:0.65s">
      <rect x="268" y="168" width="64" height="64" rx="3" />
      <text x="300" y="196" class="schema__label">CORE</text>
      <text x="300" y="212" class="schema__sub">L3</text>
    </g>
    <!-- Serveurs -->
    <g class="schema__node" style="--d:1.15s">
      <rect x="470" y="244" width="60" height="16" rx="2" />
      <rect x="470" y="264" width="60" height="16" rx="2" />
      <rect x="470" y="284" width="60" height="16" rx="2" />
      <circle cx="478" cy="252" r="1.5" fill="var(--accent)" stroke="none" />
      <circle cx="478" cy="272" r="1.5" fill="var(--accent)" stroke="none" />
      <circle cx="478" cy="292" r="1.5" fill="var(--accent)" stroke="none" />
      <text x="500" y="318" class="schema__sub">SRV</text>
    </g>
    <!-- Commutateurs d'accès -->
    {[160, 300, 440].map((x, i) => (
      <g class="schema__node" style={`--d:${1.2 + i * 0.1}s`}>
        <rect x={x - 40} y="296" width="80" height="68" rx="3" />
        <text x={x} y="326" class="schema__label">SW{i + 1}</text>
        <text x={x} y="344" class="schema__sub">VLAN {10 * (i + 1)}</text>
      </g>
    ))}
    <!-- postes -->
    {hosts.map((x, i) => (
      <circle cx={x} cy="400" r="5" class="schema__node schema__host" style={`--d:${1.7 + i * 0.05}s`} />
    ))}
  </g>

  <!-- cartouche -->
  <g class="schema__cartouche" style="--d:2s">
    <rect x="392" y="24" width="184" height="58" rx="2" fill="var(--paper-elev)" stroke="var(--line-strong)" />
    <line x1="392" y1="44" x2="576" y2="44" stroke="var(--line)" />
    <text x="400" y="38" class="schema__sub schema__sub--left">PLAN · INFRASTRUCTURE</text>
    <text x="400" y="60" class="schema__sub schema__sub--left">RÉF. HJ-2025-001</text>
    <text x="400" y="74" class="schema__sub schema__sub--left">ÉCH. 1:1 · RÉV. A</text>
  </g>
</svg>

<style>
  .schema {
    width: 100%;
    height: auto;
    color: var(--ink);
    overflow: visible;
    transform: translate3d(calc(var(--mx, 0) * -8px), calc(var(--my, 0) * -6px), 0);
    transition: transform 600ms var(--ease-out);
  }
  .schema__label, .schema__sub {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-anchor: middle;
    fill: var(--ink);
    stroke: none;
  }
  .schema__sub { font-size: 8.5px; fill: var(--ink-3); }
  .schema__sub--left { text-anchor: start; }
  .schema__hatch { color: var(--accent); opacity: 0.35; }

  /* dessin des traits */
  .schema__edge {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s var(--ease-out) forwards;
    animation-delay: var(--d, 0s);
  }
  .schema__node, .schema__cartouche {
    opacity: 0;
    animation: fade-up 700ms var(--ease-out) forwards;
    animation-delay: var(--d, 0s);
  }
  .schema__host { fill: var(--paper); }
  .schema__host:nth-child(3n) { fill: var(--accent); stroke: var(--accent); }

  /* paquets */
  .schema__packet {
    fill: var(--accent);
    opacity: 0;
    offset-rotate: 0deg;
    animation: packet var(--dur, 4s) linear infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes packet {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* parallaxe de profondeur : le cartouche et le quadrillage bougent moins */
  .schema__cartouche, .schema__grid { transform: translate3d(calc(var(--mx, 0) * 4px), calc(var(--my, 0) * 3px), 0); transition: transform 800ms var(--ease-out); }

  @media (prefers-reduced-motion: reduce) {
    .schema { transform: none; }
    .schema__edge { stroke-dashoffset: 0; animation: none; }
    .schema__node, .schema__cartouche { opacity: 1; animation: none; }
    .schema__packet { display: none; }
  }
</style>
