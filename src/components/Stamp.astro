---
/**
 * Cachet rotatif : texte en cercle qui tourne lentement, icône au centre.
 * Décoration (aria-hidden) — utilisée dans la hero.
 */
import Icon from '@/components/Icon.astro';

interface Props {
  text?: string;
  size?: number;
  class?: string;
}
const { text = 'BTS SIO · SISR · Strasbourg · 2025 → 2027 · ', size = 120, class: className } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['stamp', className]} style={`--size:${size}px`} aria-hidden="true">
  <svg class="stamp__ring" viewBox="0 0 100 100">
    <defs>
      <path id={id} d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" />
    </defs>
    <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="1 3" opacity="0.6" />
    <text font-size="9.2" letter-spacing="0.9">
      <textPath href={`#${id}`}>{text}</textPath>
    </text>
  </svg>
  <span class="stamp__core"><Icon name="network" size={20} /></span>
</div>

<style>
  .stamp {
    position: relative; width: var(--size); height: var(--size);
    display: grid; place-items: center;
    color: var(--ink-2);
  }
  .stamp__ring {
    position: absolute; inset: 0; width: 100%; height: 100%;
    font-family: var(--font-mono); font-weight: 500; text-transform: uppercase;
    fill: currentColor;
    animation: stamp-spin 28s linear infinite;
  }
  .stamp__core {
    display: grid; place-items: center;
    width: calc(var(--size) * 0.42); height: calc(var(--size) * 0.42);
    border-radius: 50%; border: 1px solid var(--line-strong);
    color: var(--accent); background: var(--bg);
  }
  @keyframes stamp-spin { to { transform: rotate(360deg); } }
</style>
