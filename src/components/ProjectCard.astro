---
/**
 * Une fiche dans une liste : ligne avec date, titre, résumé, technologies, vignette éventuelle.
 * Les attributs data-* servent aux filtres de la bibliothèque (scripts/filters.ts).
 */
import { Image } from 'astro:assets';
import { CATEGORIES, KINDS, STATUSES, type Category, type Kind, type Status } from '@/data/taxonomy';
import { getProjectRef, searchIndex, type Project } from '@/lib/projects';
import { formatMonthCap, slugify } from '@/lib/format';

interface Props {
  project: Project;
  /** Affiche la vignette de couverture si elle existe. */
  thumb?: boolean;
}
const { project, thumb = true } = Astro.props;
const d = project.data;
const ref = await getProjectRef(project);
const kind = KINDS[d.kind as Kind];
const category = CATEGORIES[d.category as Category];
const status = STATUSES[d.status as Status];
const href = `/travaux/${project.id}`;
const techs = d.technologies.slice(0, 5);
const more = d.technologies.length - techs.length;
---

<article
  class:list={['work', { 'work--thumb': thumb && d.cover }]}
  data-kind={d.kind}
  data-category={[d.category, ...d.categories].join(' ')}
  data-tech={d.technologies.map(slugify).join(' ')}
  data-year={d.date.getFullYear()}
  data-context={d.context ? slugify(d.context) : ''}
  data-status={d.status}
  data-search={searchIndex(project)}
>
  <div class="work__side">
    <time class="mono" datetime={d.date.toISOString().slice(0, 10)}>{formatMonthCap(d.date)}</time>
    <span class="work__ref mono">{ref}</span>
  </div>

  <div class="work__main">
    <h3 class="row-title"><a href={href} transition:name={`title-${project.id}`}>{d.title}</a></h3>
    <p class="work__meta meta">
      {kind.label} · {category.label}
      {d.organization && <> · {d.organization}</>}
      {d.status !== 'termine' && <> · <span class="work__status">{status.label}</span></>}
    </p>
    <p class="work__summary">{d.summary}</p>
    {techs.length > 0 ? (
      <ul class="tags" role="list" aria-label="Technologies">
        {techs.map((t) => <li class="tag">{t}</li>)}
        {more > 0 && <li class="tag">+{more}</li>}
      </ul>
    ) : (
      <p class="meta"><span class="todo">TODO</span> technologies à renseigner</p>
    )}
  </div>

  {thumb && d.cover && (
    <a href={href} class="work__thumb" tabindex="-1" aria-hidden="true">
      <Image src={d.cover} alt="" width={400} widths={[240, 400]} sizes="160px" loading="lazy" decoding="async" transition:name={`cover-${project.id}`} />
    </a>
  )}
</article>

<style>
  .work {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .work { grid-template-columns: 8.5rem minmax(0, 1fr); }
    .work--thumb { grid-template-columns: 8.5rem minmax(0, 1fr) 160px; }
  }
  .work__side { display: flex; gap: var(--s-3); color: var(--ink-3); }
  @media (min-width: 720px) { .work__side { flex-direction: column; gap: 0.15rem; padding-top: 0.2rem; } }
  .work__ref { color: var(--ink-3); opacity: 0.8; }
  .work__main { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .work__meta { margin-top: -0.15rem; }
  .work__status { color: var(--warn); }
  .work__summary { color: var(--ink-2); max-width: var(--measure); }
  .work__main .tags { margin-top: 0.2rem; }
  .work__thumb { display: block; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-2); align-self: start; }
  .work__thumb :global(img) { width: 100%; height: auto; }
</style>
