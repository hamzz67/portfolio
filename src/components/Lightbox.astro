---
/**
 * Visionneuse plein écran (élément <dialog> natif : focus, Échap et fond gérés par le navigateur).
 * Alimentée par les liens [data-lightbox] de la page (voir scripts/lightbox.ts).
 */
import Icon from '@/components/Icon.astro';
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Visionneuse d’images">
  <div class="lightbox__frame">
    <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Fermer (Échap)">
      <Icon name="x" size={22} />
    </button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Image précédente (←)">
      <Icon name="chevron-left" size={26} />
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <figcaption class="lightbox__caption">
        <span class="label" data-lightbox-counter></span>
        <span data-lightbox-caption></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Image suivante (→)">
      <Icon name="chevron-right" size={26} />
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    border: 0; padding: 0; margin: 0;
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh;
    background: transparent;
    color: var(--ink);
  }
  .lightbox::backdrop { background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(6px); }
  .lightbox[open] { display: grid; place-items: center; animation: fade-up 260ms var(--ease-out); }
  .lightbox__frame { position: relative; width: 100%; height: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; padding: 1rem; gap: 0.5rem; }
  .lightbox__figure { margin: 0; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; max-height: 100%; }
  .lightbox__img { max-width: min(100%, 1400px); max-height: calc(100dvh - 7rem); width: auto; height: auto; object-fit: contain; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-elev); box-shadow: var(--shadow-lg); }
  .lightbox__caption { display: flex; gap: 0.75rem; align-items: baseline; font-size: var(--text-sm); color: var(--ink-2); text-align: center; max-width: 70ch; }
  .lightbox__btn { display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius); background: var(--paper-elev); border: 1px solid var(--line-strong); color: var(--ink); transition: background var(--dur-fast), color var(--dur-fast); }
  .lightbox__btn:hover { background: var(--ink); color: var(--paper); }
  .lightbox__close { position: absolute; top: 1rem; right: 1rem; z-index: 2; }
  .lightbox__nav[disabled] { opacity: 0.3; pointer-events: none; }
  @media (max-width: 640px) {
    .lightbox__frame { grid-template-columns: 1fr; padding: 0.75rem; }
    .lightbox__nav { position: absolute; bottom: 4.5rem; }
    .lightbox__nav--prev { left: 0.75rem; }
    .lightbox__nav--next { right: 0.75rem; }
    .lightbox__img { max-height: calc(100dvh - 10rem); }
  }
</style>
