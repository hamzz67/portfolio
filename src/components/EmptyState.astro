---
/**
 * État vide : une note sobre qui indique où ajouter le contenu, sans rien inventer.
 */
interface Props {
  title: string;
  text?: string;
  /** Fichier à modifier pour ajouter du contenu. */
  file?: string;
}
const { title, text, file } = Astro.props;
---

<div class="note">
  <p><strong>{title}</strong></p>
  {text && <p class="note__text">{text}</p>}
  {file && <p class="note__file"><span class="todo">TODO</span> ajouter dans <code>{file}</code></p>}
  <slot />
</div>

<style>
  .note__text { margin-top: 0.4rem; max-width: 60ch; }
  .note__file { margin-top: 0.6rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
</style>
