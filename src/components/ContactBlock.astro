---
/**
 * Contact pour site statique : une liste de liens, pas de formulaire ni de backend.
 * Les valeurs TODO sont affichées comme telles, jamais comme de faux liens.
 */
import Icon from '@/components/Icon.astro';
import { profile, isPlaceholder } from '@/data/profile';

const email = isPlaceholder(profile.links.email) ? undefined : profile.links.email;
const github = isPlaceholder(profile.links.github) ? undefined : profile.links.github;
const linkedin = isPlaceholder(profile.links.linkedin) ? undefined : profile.links.linkedin;
const cv = profile.links.cv;

const items = [
  { label: 'E-mail', value: email, href: email ? `mailto:${email}` : undefined, todo: 'adresse e-mail professionnelle à renseigner', copy: email },
  { label: 'GitHub', value: github?.replace(/^https?:\/\/(www\.)?/, ''), href: github, todo: 'lien GitHub à renseigner' },
  { label: 'LinkedIn', value: linkedin?.replace(/^https?:\/\/(www\.)?/, ''), href: linkedin, todo: 'lien LinkedIn à renseigner' },
  { label: 'CV', value: cv ? 'Télécharger le CV (PDF)' : undefined, href: cv, todo: 'CV public à ajouter (sans coordonnées personnelles)', download: true },
];
---

<dl class="contact">
  {items.map((c) => (
    <div class="contact__row" data-reveal>
      <dt>{c.label}</dt>
      <dd>
        {c.href ? (
          <>
            <a
              class="link"
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'me noopener' : undefined}
              download={c.download ? '' : undefined}
            >{c.value}</a>
            {c.copy && (
              <button type="button" class="contact__copy" data-copy={c.copy} aria-label={`Copier ${c.copy}`}>
                <Icon name="copy" size={13} /> <span data-copy-label>copier</span>
              </button>
            )}
          </>
        ) : (
          <span class="meta"><span class="todo">TODO</span> {c.todo}</span>
        )}
      </dd>
    </div>
  ))}
</dl>
<p class="contact__note meta">
  Site statique, sans formulaire ni collecte de données. Adresse postale et téléphone ne sont pas publiés.
</p>

<style>
  .contact { margin: 0; border-top: 1px solid var(--line); max-width: var(--measure); }
  .contact__row { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--s-4); padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .contact dt { color: var(--ink-3); font-size: var(--text-sm); padding-top: 0.1rem; }
  .contact dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; word-break: break-word; }
  .contact__copy { display: inline-flex; align-items: center; gap: 0.25rem; font-size: var(--text-xs); color: var(--ink-3); }
  .contact__copy:hover { color: var(--ink); }
  .contact__note { margin-top: var(--s-4); max-width: var(--measure); }
</style>
