---
/** Monogramme « HJ » : cartouche de plan avec repères d'angle. */
interface Props { size?: number; class?: string }
const { size = 36, class: className } = Astro.props;
---

<svg class:list={['logo', className]} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <rect x="4.5" y="4.5" width="31" height="31" rx="3" fill="var(--paper-elev)" stroke="var(--ink)" stroke-width="1" />
  <!-- repères d'angle -->
  <path d="M1 8V1h7M32 1h7v7M39 32v7h-7M8 39H1v-7" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-linecap="round" />
  <text x="20" y="26.5" text-anchor="middle" font-family="var(--font-display)" font-size="17" font-weight="500" font-style="italic" fill="var(--ink)" letter-spacing="-0.5">HJ</text>
</svg>

<style>
  .logo { flex: none; }
  .logo text { font-family: var(--font-display); }
</style>
